{
  "name": "leadforge",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted B2B lead discovery, intelligence and compliant outreach.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @leadforge/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @leadforge/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @leadforge/database run generate",
    "db:migrate": "pnpm --filter @leadforge/database run migrate",
    "db:deploy": "pnpm --filter @leadforge/database run deploy",
    "db:seed": "pnpm --filter @leadforge/database run seed",
    "db:studio": "pnpm --filter @leadforge/database studio",
    "worker": "pnpm --filter @leadforge/worker start",
    "local": "node scripts/run-local.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f --tail=100",
    "infra:ps": "docker compose ps"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
