# Normalize line endings so a Windows checkout matches a Linux checkout.
* text=auto eol=lf

*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.gz   binary
*.zst  binary
*.woff binary
*.woff2 binary
