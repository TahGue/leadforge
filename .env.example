# ============================================================
# LeadForge — environment template
# Copy to .env and fill in. NEVER commit .env.
# Production uses Docker secrets / mounted files instead.
# ============================================================

# --- Runtime ---
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- PostgreSQL ---
POSTGRES_USER=leadforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=leadforge
# Used by Prisma and services. Keep host localhost for local dev.
DATABASE_URL=postgresql://leadforge:change-me-local-only@127.0.0.1:5432/leadforge?schema=public

# --- Redis (streams, cache, locks) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth / crypto ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=
# Dedicated key for signing unsubscribe tokens (rotate separately).
UNSUBSCRIBE_SIGNING_KEY=
# Optional: column-level PII encryption key (base64, 32 bytes).
# PII_ENCRYPTION_KEY=

# --- Object storage (Phase 4+) ---
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ROOT_USER=leadforge
# MINIO_ROOT_PASSWORD=change-me-local-only
# MINIO_BUCKET=leadforge-artifacts

# --- Search (Phase 10+, optional) ---
# OPENSEARCH_URL=http://127.0.0.1:9200

# --- Local AI (Phase 5+, optional) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CLASSIFY_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Crawler defaults ---
CRAWLER_USER_AGENT=LeadForgeBot/0.1 (+https://localhost/bot)
CRAWLER_MAX_CONCURRENT_DOMAINS=10
CRAWLER_DELAY_MS=2000
CRAWLER_MAX_PAGES_PER_COMPANY=10
CRAWLER_RESPECT_ROBOTS=true

# --- SMTP (Phase 9 — leave disabled until gates pass) ---
MAIL_ENABLED=false
# SMTP_HOST=127.0.0.1
# SMTP_PORT=587
# SMTP_USER=leadforge
# SMTP_PASSWORD=
# SMTP_FROM=outreach@mail.example.com
# SMTP_FROM_NAME=LeadForge
# MAIL_TEST_ALLOWLIST=you@example.com

# --- Retention (days) ---
RETENTION_FETCH_ARTIFACTS_DAYS=90
RETENTION_EXTRACTION_CANDIDATES_DAYS=180
RETENTION_AUDIT_DAYS=730

# --- Bounce ingestion ---
# BOUNCE_INGEST_KEY=
# MAIL_POSTAL_ADDRESS=Example AB, Storgatan 1, 111 22 Stockholm, Sweden


# --- Seed (run once) ---
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-this-before-seeding

# --- Worker ---
# WORKER_POLL_MS=15000
