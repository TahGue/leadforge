# ============================================================
# LeadForge — environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Runtime ---
NODE_ENV=development
# Public URL. Use https in production: secure cookies follow this scheme.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=leadforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=leadforge
# Host-side tools and `pnpm local`. Containers build their own URL from the values above.
DATABASE_URL=postgresql://leadforge:change-me-local-only@127.0.0.1:5432/leadforge?schema=public
# Local dev ports for docker-compose.dev.yml (change if 5432/6379 are taken)
DEV_PG_PORT=5432
DEV_REDIS_PORT=6379

# --- Redis (BullMQ orchestration; optional, Postgres sweep is the fallback) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth / crypto ---
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# Bearer token for /api/v1/metrics (Prometheus). Empty = endpoint disabled.
METRICS_TOKEN=

# --- Features ---
# Campaigns and delivery are frozen until the Phase 9 legal review (ADR-0020).
FEATURE_CAMPAIGNS=false
# Projects above this company cap need an admin's approval before they start.
DISCOVERY_HIGH_VOLUME_THRESHOLD=5000

# --- Map (Market Explorer) ---
# A MapLibre style URL from a permitted or self-hosted tile service. Applied at image build.
# Leave empty to show points without basemap tiles.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Crawler (services/leadforge) ---
# Truthful agent with a page describing your crawler and a contact (spec 24).
CRAWLER_USER_AGENT=LeadForgeResearchBot/0.2 (+https://your-domain.example/crawler-policy)
CRAWLER_GLOBAL_CONCURRENCY=4
CRAWLER_DELAY_MS=3000
CRAWLER_MAX_PAGES_PER_COMPANY=12
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_RESPONSE_MB=8
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_PLAYWRIGHT_ENABLED=false
CRAWLER_INSTALL_BROWSER=false
# Deterministic, on-domain role contacts at or above this confidence skip manual review.
CRAWLER_AUTO_PROMOTE_CONFIDENCE=0.85
CRAWLER_ROLE=all
ARTIFACT_DIR=data/artifacts
ARTIFACT_RETENTION_DAYS=90
IMPORTS_DIR=data/imports

# --- Local AI (Ollama, profile "ai") ---
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
# Benchmarked default (ADR-0025): needs ~18 GB VRAM/RAM. Re-run leadforge.ai_eval for smaller models.
OLLAMA_CLASSIFICATION_MODEL=qwen3.8:27b

# --- Verification and freshness ---
VERIFICATION_TTL_DAYS=90
COMPANY_FRESHNESS_DAYS=180

# --- Retention (days) ---
RETENTION_EXTRACTION_CANDIDATES_DAYS=180
RETENTION_STAGING_DAYS=90
RETENTION_AUDIT_DAYS=730

# --- Worker ---
WORKER_POLL_MS=15000
WORKER_STALE_RUNNING_MINUTES=30
# Company candidates normalized in parallel (independent domains only; caps stay exact).
NORMALIZE_CONCURRENCY=8

# --- Monitoring profile ---
# Grafana admin password: write it to infrastructure/monitoring/grafana-admin-password (git-ignored).

# --- Seed (run once; change the password afterwards) ---
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-this-before-seeding

# --- Phase 9 only (ignored while FEATURE_CAMPAIGNS=false) ---
# UNSUBSCRIBE_SIGNING_KEY=
# MAIL_ENABLED=false
# MAIL_POSTAL_ADDRESS=
# BOUNCE_INGEST_KEY=

# --- Published ports (loopback only) ---
WEB_PORT=3000
GRAFANA_PORT=3001
